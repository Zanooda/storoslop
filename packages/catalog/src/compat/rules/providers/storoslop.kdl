// Provider-wire compat for "storoslop"; the fork's single-provider gateway.
// Deployment contract authored by hand: the gateway is fork-private, so no
// frozen census covers it and this file is the authoritative wire contract.

provider "storoslop" {
	default-model "deepseek-v4.1-flash"
	env "STOROSLOP_API_KEY"
	// Fork-curated seed for the fork-private single-provider gateway. No
	// upstream catalog source lists storoslop and it exposes no discovery
	// endpoint, so this roster is the entire bundled surface in every regen
	// (the runtime manager also pins it via `staticModels`). The thinking
	// ladder mirrors the gateway's vLLM serving contract.
	seed api="openai-completions" base-url="http://slop.storo.cloud:4000/v1" bundle="always" {
		model "deepseek-v4.1-flash" name="deepseek-v4.1-flash" {
			reasoning #true
			input "text" "image"
			supports-tools #true
			cost input=0.14 output=0.28 cache-read=0.028 cache-write=0
			limits context=1048576 max-tokens=131072
			thinking-mode "effort"
			thinking-efforts "low" "high" "xhigh" "max"
			thinking-default-level "high"
		}
	}

	// The gateway serves DeepSeek-V4.1-Flash behind vLLM on an
	// OpenAI-chat-completions surface (`--enable-auto-tool-choice
	// --tool-call-parser deepseek_v41`). `reasoning_effort` accepts
	// low/high/xhigh/max (minimal/medium remap onto the nearest supported
	// rung) or `none` to disable thinking, and reasoning round-trips in the
	// plain `reasoning` field rather than DeepSeek's usual `reasoning_content`.
	class "deepseek" {
		family "flash" {
			// The class rule (classes/deepseek.kdl) pins the V4 flash ladder to
			// low/high/max and strips image input for the whole lineage; this
			// rule must carry a models selector to outrank it on dimensions and
			// win the efforts/defaultLevel axes for this gateway.
			models "*deepseek-v4.1-flash" {
				thinking-default-level "high"
				thinking-efforts "low" "high" "xhigh" "max"
				strip-image-input #false
			}
			reasoning-effort-map {
				minimal "low"
				medium "high"
			}
			supports-reasoning-effort #true
			reasoning-disable-mode "none-effort"
			thinking-mode "effort"
			thinking-format "openai"
			reasoning-content-field "reasoning"
			max-tokens-field "max_tokens"
			// vLLM keeps reasoning on when `tool_choice` is present; the
			// deepseek class default (native-API behaviour) would drop it.
			supports-tool-choice #true
			disable-reasoning-on-tool-choice #false
		}
	}
}
